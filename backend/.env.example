# Copy to .env for local development. Never commit .env.

# Required. Signs login tokens. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required. PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medicaldocs

# Required for chat, extraction and comparison (Gemini).
GOOGLE_API_KEY=

# Required for uploads (originals are stored privately in Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed browser origin for CORS (the deployed frontend URL in production).
FRONTEND_URL=http://localhost:5173

# Optional. Path to tesseract if it is not on PATH, e.g. on Windows:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional. Where vectors are stored (default chroma_db). Rebuilt from saved text if lost.
CHROMA_PATH=chroma_db

# Optional. Per-user limit for chat/extract/compare requests per minute (default 20).
LLM_REQUESTS_PER_MINUTE=20
